'use client';

import { useEffect, useState } from 'react';
import { supabase } from './lib/supabase';

interface MenuItem {
  id: string;
  name: string;
  description: string;
  price: number;
  category: string;
  is_available: boolean;
}

interface CartItem extends MenuItem {
  quantity: number;
}

export default function Home() {
  const [menuItems, setMenuItems] = useState<MenuItem[]>([]);
  const [cart, setCart] = useState<CartItem[]>([]);
  const [loading, setLoading] = useState(true);
  const [isCheckoutOpen, setIsCheckoutOpen] = useState(false);
  const [isSubmitting, setIsSubmitting] = useState(false);

  // Form states
  const [tableNumber, setTableNumber] = useState('');
  const [customerName, setCustomerName] = useState('');
  const [notes, setNotes] = useState('');

  useEffect(() => {
    async function fetchMenu() {
      try {
        const { data, error } = await supabase
          .from('menu_items')
          .select('*')
          .eq('is_available', true);

        if (error) console.error(error);
        if (data) setMenuItems(data);
      } catch (err) {
        console.error(err);
      } finally {
        setLoading(false);
      }
    }

    fetchMenu();
  }, []);

  const addToCart = (item: MenuItem) => {
    setCart((prev) => {
      const existing = prev.find((i) => i.id === item.id);
      if (existing) {
        return prev.map((i) =>
          i.id === item.id ? { ...i, quantity: i.quantity + 1 } : i
        );
      }
      return [...prev, { ...item, quantity: 1 }];
    });
  };

  const updateQuantity = (id: string, delta: number) => {
    setCart((prev) =>
      prev
        .map((item) => {
          if (item.id === id) {
            const newQty = item.quantity + delta;
            return newQty > 0 ? { ...item, quantity: newQty } : null;
          }
          return item;
        })
        .filter(Boolean) as CartItem[]
    );
  };

  const totalAmount = cart.reduce(
    (sum, item) => sum + item.price * item.quantity,
    0
  );
  const totalItemCount = cart.reduce((sum, item) => sum + item.quantity, 0);

  const handlePlaceOrder = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!tableNumber) {
      alert('Please enter your table number.');
      return;
    }

    setIsSubmitting(true);

    try {
      // 1. Create main order record
      const { data: orderData, error: orderError } = await supabase
        .from('orders')
        .insert({
          table_number: tableNumber,
          customer_name: customerName || null,
          notes: notes || null,
          total_amount: totalAmount,
          status: 'pending',
        })
        .select()
        .single();

      if (orderError) throw orderError;

      // 2. Create order line items
      const orderItems = cart.map((item) => ({
        order_id: orderData.id,
        menu_item_id: item.id,
        quantity: item.quantity,
        unit_price: item.price,
      }));

      const { error: itemsError } = await supabase
        .from('order_items')
        .insert(orderItems);

      if (itemsError) throw itemsError;

      // Reset cart and modal on success
      setCart([]);
      setIsCheckoutOpen(false);
      setNotes('');
      alert(`Order #${orderData.id.slice(0, 8)} submitted successfully!`);
    } catch (err) {
      console.error('Failed to submit order:', err);
      alert('Something went wrong placing your order. Please try again.');
    } finally {
      setIsSubmitting(false);
    }
  };

  const categories = Array.from(new Set(menuItems.map((item) => item.category)));

  if (loading) {
    return (
      <div className="flex min-h-screen items-center justify-center bg-zinc-950 text-white">
        <p className="text-lg font-medium animate-pulse">Loading menu...</p>
      </div>
    );
  }

  return (
    <main className="min-h-screen bg-zinc-950 text-zinc-100 p-4 sm:p-8 max-w-2xl mx-auto pb-28">
      <header className="mb-8 text-center border-b border-zinc-800 pb-6">
        <h1 className="text-3xl font-bold tracking-tight text-amber-500">
          Moroccan Delights
        </h1>
        <p className="text-zinc-400 text-sm mt-1">Scan. Order. Enjoy.</p>
      </header>

      {/* Category List */}
      {categories.map((category) => (
        <section key={category} className="mb-8">
          <h2 className="text-xl font-semibold mb-4 text-amber-400 border-b border-zinc-800 pb-2">
            {category}
          </h2>
          <div className="space-y-4">
            {menuItems
              .filter((item) => item.category === category)
              .map((item) => {
                const cartCount =
                  cart.find((i) => i.id === item.id)?.quantity || 0;

                return (
                  <div
                    key={item.id}
                    className="bg-zinc-900 border border-zinc-800 rounded-xl p-4 flex justify-between items-center shadow-sm"
                  >
                    <div className="pr-4">
                      <h3 className="font-medium text-lg text-white">
                        {item.name}
                      </h3>
                      <p className="text-zinc-400 text-sm mt-1">
                        {item.description}
                      </p>
                      <p className="text-amber-500 font-bold mt-2">
                        {item.price} MAD
                      </p>
                    </div>

                    {cartCount > 0 ? (
                      <div className="flex items-center space-x-2 bg-zinc-800 rounded-lg p-1 border border-zinc-700">
                        <button
                          onClick={() => updateQuantity(item.id, -1)}
                          className="w-8 h-8 rounded bg-zinc-700 hover:bg-zinc-600 text-white font-bold flex items-center justify-center"
                        >
                          -
                        </button>
                        <span className="w-6 text-center font-medium text-amber-400">
                          {cartCount}
                        </span>
                        <button
                          onClick={() => updateQuantity(item.id, 1)}
                          className="w-8 h-8 rounded bg-amber-600 hover:bg-amber-500 text-white font-bold flex items-center justify-center"
                        >
                          +
                        </button>
                      </div>
                    ) : (
                      <button
                        onClick={() => addToCart(item)}
                        className="bg-amber-600 hover:bg-amber-500 text-white font-medium px-4 py-2 rounded-lg text-sm transition-colors whitespace-nowrap"
                      >
                        Add +
                      </button>
                    )}
                  </div>
                );
              })}
          </div>
        </section>
      ))}

      {/* Floating Cart Bar */}
      {cart.length > 0 && (
        <div className="fixed bottom-4 left-4 right-4 max-w-2xl mx-auto z-40">
          <button
            onClick={() => setIsCheckoutOpen(true)}
            className="w-full bg-amber-600 hover:bg-amber-500 text-white font-semibold py-4 px-6 rounded-2xl shadow-xl flex justify-between items-center transition-all"
          >
            <div className="flex items-center space-x-3">
              <span className="bg-amber-800 text-amber-100 text-xs font-bold px-2.5 py-1 rounded-full">
                {totalItemCount}
              </span>
              <span>View Cart</span>
            </div>
            <span className="font-bold text-lg">{totalAmount.toFixed(2)} MAD</span>
          </button>
        </div>
      )}

      {/* Checkout Modal */}
      {isCheckoutOpen && (
        <div className="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-end sm:items-center justify-center p-0 sm:p-4">
          <div className="bg-zinc-900 border border-zinc-800 w-full max-w-md rounded-t-2xl sm:rounded-2xl p-6 shadow-2xl max-h-[90vh] overflow-y-auto">
            <div className="flex justify-between items-center border-b border-zinc-800 pb-4 mb-4">
              <h2 className="text-xl font-bold text-amber-400">Your Order</h2>
              <button
                onClick={() => setIsCheckoutOpen(false)}
                className="text-zinc-400 hover:text-white font-bold text-lg"
              >
                ✕
              </button>
            </div>

            {/* Cart items list */}
            <div className="space-y-3 mb-6">
              {cart.map((item) => (
                <div
                  key={item.id}
                  className="flex justify-between items-center bg-zinc-950 p-3 rounded-xl border border-zinc-800"
                >
                  <div>
                    <p className="font-medium text-white">{item.name}</p>
                    <p className="text-xs text-zinc-400">
                      {item.price} MAD x {item.quantity}
                    </p>
                  </div>
                  <div className="flex items-center space-x-2">
                    <button
                      onClick={() => updateQuantity(item.id, -1)}
                      className="w-7 h-7 bg-zinc-800 hover:bg-zinc-700 rounded text-white font-bold text-sm"
                    >
                      -
                    </button>
                    <span className="text-sm font-semibold">{item.quantity}</span>
                    <button
                      onClick={() => updateQuantity(item.id, 1)}
                      className="w-7 h-7 bg-amber-600 hover:bg-amber-500 rounded text-white font-bold text-sm"
                    >
                      +
                    </button>
                  </div>
                </div>
              ))}
            </div>

            {/* Order Form */}
            <form onSubmit={handlePlaceOrder} className="space-y-4">
              <div>
                <label className="block text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-1">
                  Table Number *
                </label>
                <input
                  type="text"
                  required
                  value={tableNumber}
                  onChange={(e) => setTableNumber(e.target.value)}
                  placeholder="e.g., Table 4"
                  className="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-500"
                />
              </div>

              <div>
                <label className="block text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-1">
                  Your Name (Optional)
                </label>
                <input
                  type="text"
                  value={customerName}
                  onChange={(e) => setCustomerName(e.target.value)}
                  placeholder="e.g., Youssef"
                  className="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-500"
                />
              </div>

              <div>
                <label className="block text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-1">
                  Special Notes / Requests
                </label>
                <textarea
                  value={notes}
                  onChange={(e) => setNotes(e.target.value)}
                  placeholder="e.g., No onions on tagine, extra mint in tea..."
                  rows={2}
                  className="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-500"
                />
              </div>

              <div className="border-t border-zinc-800 pt-4 flex justify-between items-center mb-4">
                <span className="text-zinc-400 font-medium">Total</span>
                <span className="text-2xl font-bold text-amber-500">
                  {totalAmount.toFixed(2)} MAD
                </span>
              </div>

              <button
                type="submit"
                disabled={isSubmitting}
                className="w-full bg-amber-600 hover:bg-amber-500 text-white font-bold py-3.5 rounded-xl transition-all disabled:opacity-50"
              >
                {isSubmitting ? 'Placing Order...' : 'Confirm & Send Order'}
              </button>
            </form>
          </div>
        </div>
      )}
    </main>
  );
}
